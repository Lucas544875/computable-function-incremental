{
  "files": { "includes": ["src/**", "tests/**", "!src/styles/paper.css"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noExplicitAny": "off" },
      "complexity": { "useMathMinMax": "off" }
    }
  }
}
